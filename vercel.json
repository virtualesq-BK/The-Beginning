{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 300 }
    }
  ],
  "functions": {
    "api/index.py": { "maxDuration": 300 }
  },
  "routes": [
    { "src": "/health", "dest": "/api/index.py" },
    { "src": "/api/v1/(.*)", "dest": "/api/index.py" },
    { "src": "/(.*\\.[A-Za-z0-9]+)", "dest": "/frontend/$1" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
