OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://monogpt.kr/api/monorouter/v1/openai/v1
OPENAI_EMBED_MODEL=text-embedding-3-small

# 역할별 모델 (생략 시 아래 기본값)
# worker = 싸게 많이 처리하는 작업자 (파싱·번역·요약)
# agent  = 더 똑똑한 Agent 작업자 (조항 위험 분석·계약서 생성) — Universal 게이트웨이 우선
# expert = 최종 판단을 맡길 전문가 — Universal 게이트웨이 우선
LLM_MODEL_WORKER=gpt-5-mini
LLM_MODEL_AGENT=gpt-5.6-luna
LLM_MODEL_EXPERT=gpt-5.6-sol

# (선택) monorouter Universal 게이트웨이 — gpt-5.6 계열 등 별도 모델 호출용 전용 클라이언트
# Universal_API=your_universal_api_key
# Universal_URL=https://monogpt.kr/api/monorouter/v1/
# Universal_MODEL=gpt-5-nano-chat

# 전문가 연결 요청 수신 주소
EXPERT_EMAIL=virtual.esq@gmail.com

# (선택) Gmail SMTP — 설정 시 FormSubmit 대신 SMTP로 발송
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=virtual.esq@gmail.com
# SMTP_PASSWORD=your_gmail_app_password
